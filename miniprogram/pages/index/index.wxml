<view class="page">
  <view class="brand">旅迹 <text>TRAVEL JOURNAL</text></view>
  <view class="heading">把向往，写成行程。</view><view class="muted">不用赶路，去感受路。</view>
  <view class="top-actions"><button class="primary" bindtap="newTrip">＋ 创建旅行</button><picker range="{{tripTitles}}" value="{{selected}}" bindchange="selectTrip"><view class="switch">切换旅行 ▾</view></picker></view>
  <view class="hero"><view class="pill">✦ 下一场出发</view><view class="title">{{trip.title}}</view><view class="description">{{trip.description}}</view><view class="meta">⌖ {{trip.destination}} · {{trip.start}} · {{trip.days}}天 · {{trip.people}}人</view><view class="hero-link" bindtap="editTrip">编辑旅行信息 ↗</view></view>
  <view class="navigation"><view class="{{view === 'plan' ? 'active' : ''}}" data-view="plan" bindtap="switchView">每日行程</view><view class="{{view === 'route' ? 'active' : ''}}" data-view="route" bindtap="switchView">地点总览</view><view class="{{view === 'budget' ? 'active' : ''}}" data-view="budget" bindtap="switchView">旅行账本</view></view>
  <block wx:if="{{view === 'plan'}}"><scroll-view scroll-x class="days"><view wx:for="{{days}}" wx:key="index" class="day {{day === item.index ? 'selected' : ''}}" data-day="{{item.index}}" bindtap="selectDay"><view>DAY {{item.number}}</view><text>{{item.date}}</text></view></scroll-view><view class="day-caption">{{currentDate}} · {{stops.length}} 个地点</view>
    <view wx:for="{{stops}}" wx:key="id" class="card"><view class="card-top"><text>{{item.time}} · {{item.category}}</text><view><text class="edit" data-id="{{item.id}}" bindtap="editStop">编辑</text><text class="delete" data-id="{{item.id}}" bindtap="deleteStop">删除</text></view></view><view class="stop-name">{{item.name}}</view><view class="muted note">{{item.note}}</view><view class="card-bottom"><text>⌖ {{item.address || '未填写地址'}}</text><text>¥{{item.cost}}</text></view></view>
    <view wx:if="{{!stops.length}}" class="empty">这一天还空着，添加一个想去的地方吧。</view><button class="add" bindtap="addStop">＋ 添加一个想去的地方</button>
  </block>
  <block wx:if="{{view === 'route'}}"><view class="muted notice">按天和时间排列地点。复制地址后可到地图应用搜索。</view><view wx:for="{{routeDays}}" wx:key="day" class="card"><view class="stop-name">DAY {{item.day}} · {{item.date}}</view><view wx:if="{{!item.stops.length}}" class="muted note">今天还没有安排</view><view wx:for="{{item.stops}}" wx:for-item="stop" wx:key="id" class="route-stop" data-id="{{stop.id}}" bindtap="copyAddress"><text>{{stop.time}} {{stop.name}}</text><text class="copy">复制地址 ↗</text></view></view></block>
  <block wx:if="{{view === 'budget'}}"><view class="budget"><view>行程预估总花费</view><view class="amount">¥ {{total}}</view><view>{{overBudget ? '超出预算' : '预算剩余'}} ¥ {{remaining}} · {{trip.people}}人合计</view></view><view wx:for="{{categories}}" wx:key="name" class="budget-row"><text>{{item.name}} · {{item.count}}项</text><text>¥ {{item.total}}</text></view><view class="muted notice">花费为手动填写的估算；暂不包含尚未安排的消费。</view></block>
  <view class="reminder">留一点时间，给计划外的美好。</view><button class="secondary" bindtap="exportTrip">复制完整行程</button><view class="muted local">{{saveFailed ? '保存失败，请复制行程备份' : '已保存在当前设备'}} · 不会自动同步到其他设备</view>
</view>
<view wx:if="{{editor}}" class="overlay"><scroll-view scroll-y class="sheet"><view class="sheet-heading">{{editor.title}}<text bindtap="closeEditor">×</text></view>
  <block wx:if="{{editor.type === 'trip'}}"><view class="label">旅行名称 *</view><input value="{{form.title}}" data-field="title" bindinput="inputField" maxlength="60" placeholder="例如：杭州山水之旅"/><view class="label">目的地 *</view><input value="{{form.destination}}" data-field="destination" bindinput="inputField" maxlength="40"/><view class="label">出发日期</view><picker mode="date" value="{{form.start}}" bindchange="inputDate"><view class="input">{{form.start}}</view></picker><view class="label">旅行天数（1–30）</view><input type="number" value="{{form.days}}" data-field="days" bindinput="inputField"/><view class="label">同行人数（1–100）</view><input type="number" value="{{form.people}}" data-field="people" bindinput="inputField"/><view class="label">总预算（元）</view><input type="digit" value="{{form.budget}}" data-field="budget" bindinput="inputField"/><view class="label">旅行寄语</view><input value="{{form.description}}" data-field="description" bindinput="inputField" maxlength="160"/></block>
  <block wx:else><view class="label">地点名称 *</view><input value="{{form.name}}" data-field="name" bindinput="inputField" maxlength="80"/><view class="label">计划时间</view><picker mode="time" value="{{form.time}}" bindchange="inputTime"><view class="input">{{form.time}}</view></picker><view class="label">类型</view><picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="inputCategory"><view class="input">{{form.category}}</view></picker><view class="label">地址</view><input value="{{form.address}}" data-field="address" bindinput="inputField" maxlength="160"/><view class="label">预估花费（元，所有人合计）</view><input type="digit" value="{{form.cost}}" data-field="cost" bindinput="inputField"/><view class="label">旅行备注</view><textarea value="{{form.note}}" data-field="note" bindinput="inputField" maxlength="500"/></block>
  <view wx:if="{{error}}" class="error">{{error}}</view><button class="primary save" bindtap="saveEditor">保存</button><view class="sheet-space"></view>
</scroll-view></view>
