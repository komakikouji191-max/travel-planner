.page{padding:36rpx 36rpx 70rpx}.brand{font-size:36rpx;font-weight:700;letter-spacing:5rpx;color:#47765c}.brand text{font-size:17rpx;letter-spacing:3rpx;margin-left:16rpx;color:#8a938b}.heading{font-size:42rpx;font-weight:600;margin:44rpx 0 16rpx}.top-actions{display:flex;align-items:center;justify-content:space-between;margin:30rpx 0}.top-actions button{margin:0;font-size:24rpx}.switch{font-size:24rpx;color:#47765c;padding:20rpx}.hero{background:linear-gradient(135deg,#e9efde,#d4e0c3);border-radius:24rpx;padding:36rpx;position:relative}.pill{font-size:22rpx;color:#6a845e}.title{font-size:44rpx;font-weight:600;margin:24rpx 0;line-height:1.5}.description{font-size:25rpx;line-height:1.8;color:#718167}.meta{font-size:23rpx;margin:25rpx 0;color:#5f7257}.hero-link{font-size:24rpx;color:#47765c}.navigation{display:flex;margin:38rpx 0 28rpx;border-bottom:1rpx solid #e0e6d9}.navigation view{flex:1;text-align:center;padding:22rpx 0;color:#8b9685}.navigation .active{color:#47765c;font-weight:600;border-bottom:5rpx solid #47765c}.days{white-space:nowrap;margin-bottom:28rpx}.day{display:inline-block;background:#fff;border:1rpx solid #e4e8df;border-radius:16rpx;padding:20rpx 28rpx;margin-right:16rpx;color:#8c9786;font-size:24rpx}.day text{display:block;font-size:21rpx;margin-top:9rpx}.day.selected{background:#47765c;color:#fff;border-color:#47765c}.day-caption{font-size:25rpx;margin:22rpx 0}.card{background:#fff;border:1rpx solid #e4e8df;border-radius:20rpx;padding:30rpx;margin-bottom:24rpx}.card-top{display:flex;align-items:center;justify-content:space-between;color:#86977d;font-size:23rpx}.edit,.delete{padding:12rpx}.delete{color:#ac9185}.stop-name{font-size:31rpx;font-weight:600;margin:22rpx 0}.note{line-height:1.8;white-space:pre-wrap;word-break:break-all}.card-bottom{display:flex;gap:20rpx;justify-content:space-between;font-size:22rpx;color:#8d9983;margin-top:22rpx}.card-bottom text:first-child{flex:1}.add{background:#eef3e7;color:#6c855f;border:2rpx dashed #cbd6c3}.reminder{padding:36rpx;background:#f0eadb;color:#77785b;border-radius:18rpx;margin:34rpx 0;font-size:28rpx}.local{font-size:21rpx;text-align:center;line-height:1.8;margin-top:25rpx}.notice{margin:24rpx 0;line-height:1.8}.route-stop{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx solid #e8ecdf;padding:25rpx 0;font-size:25rpx}.copy{font-size:22rpx;color:#47765c;flex-shrink:0}.budget{padding:40rpx;background:#e9efdf;border-radius:20rpx;font-size:25rpx}.amount{font-size:65rpx;margin:24rpx 0}.budget-row{display:flex;justify-content:space-between;border-bottom:1rpx solid #e1e7d9;padding:30rpx 0;font-size:26rpx}.empty{color:#8a938b;text-align:center;padding:40rpx 0;font-size:25rpx}.overlay{position:fixed;inset:0;background:#263c3566;z-index:10;display:flex;align-items:flex-end}.sheet{background:#f7f8f2;border-radius:30rpx 30rpx 0 0;max-height:88vh;box-sizing:border-box;padding:36rpx;width:100%}.sheet-heading{display:flex;justify-content:space-between;font-size:34rpx;font-weight:600;margin-bottom:30rpx}.sheet-heading text{padding:0 15rpx;font-size:44rpx;color:#8a938b}.label{font-size:25rpx;margin:24rpx 0 12rpx}input,.input,textarea{background:#fff;border:1rpx solid #d8dfd0;border-radius:12rpx;padding:20rpx;font-size:28rpx;width:100%;min-height:78rpx}textarea{height:150rpx}.save{margin-top:30rpx}.error{color:#b35446;font-size:24rpx;margin-top:20rpx}.sheet-space{height:60rpx}
