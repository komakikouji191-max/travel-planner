<view
  class="app {{tab === 'light' && lightView === 'map' ? 'night light-map-page' : ''}} {{detail ? 'city-page' : tab === 'map' ? 'atlas-home' : tab === 'trips' ? 'trips-page' : tab === 'souvenirs' ? 'souvenir-page' : ''}}"
  style="padding-top:{{detail ? 0 : safeTop}}px"
>
  <view wx:if="{{!detail && tab === 'mine'}}" class="masthead"
    ><text class="wordmark">旅迹 / ROAM</text
    ><text class="edition">私人旅行手账</text></view
  >
  <block wx:if="{{detail && active}}">
    <view
      wx:if="{{timelineOnly}}"
      class="diary-page"
      style="padding-top:{{safeTop}}px"
      ><view class="diary-heading"
        ><text bindtap="back">‹</text
        ><view
          ><view>{{activeEnglish}} · {{active.city}}</view
          ><text>{{active.date}} - {{active.end}}</text></view
        ><text bindtap="cityMenu">···</text></view
      ><scroll-view scroll-x class="diary-days"
        ><view
          wx:for="{{itineraryDays}}"
          wx:key="date"
          class="{{day === item.date ? 'selected-day' : ''}}"
          data-value="{{item.date}}"
          bindtap="day"
          ><text>{{item.label}}</text><text>{{item.short}}</text></view
        ></scroll-view
      ><view class="diary-line"
        ><view wx:for="{{stops}}" wx:key="id" class="diary-stop"
          ><view class="diary-node"></view
          ><view class="diary-time"
            ><view>{{item.time}}</view
            ><image
              wx:if="{{item.photos.length}}"
              src="{{item.photos[0]}}"
              mode="aspectFill"
              data-url="{{item.photos[0]}}"
              data-urls="{{item.photos}}"
              bindtap="preview" /></view
          ><view class="diary-content"
            ><view class="diary-name" data-id="{{item.id}}" bindtap="editStop"
              >{{item.name}}</view
            ><view class="diary-description">{{item.note}}</view
            ><view class="diary-gallery"
              ><image
                wx:for="{{item.previewPhotos}}"
                wx:for-item="url"
                wx:key="*this"
                src="{{url}}"
                mode="aspectFill"
                data-url="{{url}}"
                data-urls="{{item.photos}}"
                bindtap="preview"
              /><view
                wx:if="{{item.overflow}}"
                class="diary-overflow"
                data-url="{{item.photos[0]}}"
                data-urls="{{item.photos}}"
                bindtap="preview"
                >+{{item.overflow}}</view
              ></view
            ></view
          ></view
        ></view
      ><view wx:if="{{!stops.length}}" class="empty" bindtap="addStop"
        >＋ 记录这一天</view
      ><view class="small-add" bindtap="addStop">＋ 添加去过的地方</view></view
    ><block wx:else>
      <view class="city-hero">
        <image class="hero-photo" src="{{activeCover}}" mode="aspectFill" />
        <view class="hero-shade"></view>
        <view class="city-tools" style="top:{{safeTop}}px"
          ><text bindtap="back">‹</text
          ><view
            ><text bindtap="toggleFavorite"
              >{{active.favorite ? '♥' : '♡'}}</text
            ><text bindtap="cityMenu">···</text></view
          ></view
        >
        <view class="city-heading"
          ><view class="city-english">{{activeEnglish}}</view
          ><view class="city-location"
            >{{active.city}} · {{activeProvince}}</view
          ><view class="city-dates"
            >{{active.date}} — {{active.end}} · {{activeDays}} DAYS</view
          ></view
        >
        <view class="city-verse"
          >{{active.note || '在这里，风和日落都很温柔。'}}</view
        ><view class="postmark">ROAM<text>MEMORIES</text></view>
      </view>
      <view class="city-paper">
        <view class="city-tabs"
          ><text
            wx:for="{{detailTabs}}"
            wx:key="*this"
            class="{{detailTab === item ? 'active-tab' : ''}}"
            data-value="{{item}}"
            bindtap="detailTab"
            >{{item}}</text
          ></view
        >
        <block wx:if="{{detailTab === 'Overview' || detailTab === 'Photos'}}">
          <view class="city-stats"
            ><view><text>{{activeDays}}</text>Days</view
            ><view><text>{{photos.length}}</text>Photos</view
            ><view><text>{{activeSunrises}}</text>Sunrises</view
            ><view><text>{{activeSunsets}}</text>Sunsets</view></view
          >
          <view class="memory-title"
            >MEMORIES
            <text data-index="0" bindtap="openViewer">View all ↗</text></view
          >
          <scroll-view
            scroll-x
            enhanced
            show-scrollbar="{{false}}"
            class="memory-scroll"
            bindtouchstart="touchStart"
            bindtouchmove="touchMove"
            bindtouchend="touchEnd"
            bindtouchcancel="touchEnd"
            ><view
              class="memory-reel"
              style="transform:rotate({{-5 + tilt}}deg)"
              ><view
                wx:for="{{photos}}"
                wx:key="photoKey"
                class="memory-frame"
                data-index="{{index}}"
                bindtap="openViewer"
                ><view class="reel-number"
                  >ROAM 400 <text>{{index + 1}}</text></view
                ><image src="{{item.url}}" mode="aspectFill" /><view
                  class="reel-number"
                  >{{item.time}}　 ▷</view
                ></view
              ><view
                wx:if="{{!photos.length}}"
                class="memory-empty"
                bindtap="addStop"
                >＋ Add your first memory</view
              ></view
            ></scroll-view
          >
          <view class="city-signature">{{activeEnglish}}</view
          ><view class="small-add" bindtap="addStop">＋ 留下新的回忆</view>
        </block>
        <block wx:elif="{{detailTab === 'Itinerary'}}"
          ><scroll-view scroll-x class="horizontal"
            ><text
              wx:for="{{dates}}"
              wx:key="*this"
              class="date-chip {{day === item ? 'chosen' : ''}}"
              data-value="{{item}}"
              bindtap="day"
              >{{item}}</text
            ></scroll-view
          ><view class="timeline"
            ><view wx:for="{{stops}}" wx:key="id" class="stop"
              ><view class="dot"></view
              ><view class="eyebrow">{{item.date}} · {{item.time}}</view
              ><view class="stop-title">{{item.name}}</view
              ><view class="note">{{item.note}}</view
              ><scroll-view scroll-x class="stop-photos"
                ><image
                  wx:for="{{item.photos}}"
                  wx:for-item="url"
                  wx:key="*this"
                  src="{{url}}"
                  mode="aspectFill"
                  data-url="{{url}}"
                  data-urls="{{item.photos}}"
                  bindtap="preview" /></scroll-view
              ><view class="record-actions"
                ><text data-id="{{item.id}}" bindtap="editStop">编辑</text
                ><text data-id="{{item.id}}" bindtap="deleteStop"
                  >删除</text
                ></view
              ></view
            ></view
          ><view class="small-add" bindtap="addStop">＋ 添加足迹</view></block
        >
        <block wx:else
          ><view class="notes-title">Notes from {{activeEnglish}}</view
          ><view class="journal-note"
            >{{active.note || '把这段旅行的故事写在这里。'}}</view
          ><view class="small-add" bindtap="editTrip">编辑旅行手记 ↗</view
          ><view class="small-add" bindtap="exportText"
            >复制旅行文字 ↗</view
          ></block
        >
      </view>
    </block>
  </block>
  <block wx:elif="{{tab === 'map'}}">
    <view class="atlas-top"
      ><view class="atlas-word"
        >{{scope === '世界' ? 'ROAM' : 'CHINA'}}<text
          wx:if="{{scope === '中国'}}"
          class="atlas-caret"
          data-value="世界"
          bindtap="scope"
          >⌄</text
        ></view
      ><view class="atlas-search" bindtap="openAdd"
        ><view class="search-ring"></view></view
    ></view>
    <view wx:if="{{scope === '世界'}}" class="atlas-script"
      >Collect places.<text>My Story.</text></view
    >
    <view wx:else class="atlas-subnav"
      ><text
        wx:for="{{atlasLayers}}"
        wx:key="id"
        class="{{atlasLayer === item.id ? 'is-current' : ''}}"
        data-value="{{item.id}}"
        bindtap="atlasLayer"
        >{{item.label}}</text
      ></view
    >
    <view class="paper-atlas {{scope === '中国' ? 'china-atlas' : ''}}">
      <canvas
        type="2d"
        id="atlasCanvas"
        class="atlas-canvas"
        bindtouchend="atlasTap"
      ></canvas>
      <view wx:if="{{scope === '中国'}}" class="china-handwriting">China</view>
      <view
        wx:for="{{atlasPoints}}"
        wx:key="id"
        class="atlas-city"
        style="left:{{item.x}}%;top:{{item.y}}%"
        data-index="{{item.index}}"
        bindtap="atlasCityTap"
        ><view class="city-ember"></view
      ></view>
      <view
        wx:for="{{atlasStickers}}"
        wx:key="id"
        class="atlas-sticker"
        style="left:{{item.x}}%;top:{{item.y}}%;transform:translate(-50%,-50%) rotate({{item.angle}}deg)"
        data-id="{{item.id}}"
        bindtap="atlasStickerTap"
        ><image src="{{item.photos[0]}}" mode="aspectFill"
      /></view>
      <view
        wx:if="{{scope === '中国' && atlasPoints.length}}"
        class="atlas-callout"
        style="left:{{atlasPoints[0].x}}%;top:{{atlasPoints[0].y}}%"
        data-index="0"
        bindtap="atlasCityTap"
        ><view>{{atlasPoints[0].name}}</view
        ><text>{{atlasPoints[0].photos.length}} photos</text></view
      >
    </view>
    <view wx:if="{{scope === '世界'}}" class="atlas-totals"
      ><view><text>{{countryCount}}</text>Countries</view
      ><view><text>{{cityCount}}</text>Cities</view
      ><view><text>{{dayCount}}</text>Days</view
      ><view><text>{{photoCount}}</text>Photos</view></view
    >
    <view wx:else class="province-paper"
      ><view class="province-heading" bindtap="atlasRegionOpen"
        ><view>{{atlasRegion.english}} · {{atlasRegion.short}}</view
        ><text>···</text></view
      ><view class="province-meta"
        >{{atlasRegion.cities}} cities · {{atlasRegion.photoCount}} photos ·
        {{atlasRegion.trips}} trips</view
      ><view wx:if="{{atlasRegion.photos.length}}" class="province-photos"
        ><image
          wx:for="{{atlasRegion.photos}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          data-urls="{{atlasRegion.photos}}"
          bindtap="preview" /></view
      ><view wx:else class="province-empty" bindtap="atlasRegionOpen"
        >＋ 记录这里的第一段回忆</view
      ></view
    >
    <view class="atlas-toggle"
      ><text
        class="{{scope === '世界' ? 'on' : ''}}"
        data-value="世界"
        bindtap="scope"
        >World</text
      ><text
        class="{{scope === '中国' ? 'on' : ''}}"
        data-value="中国"
        bindtap="scope"
        >China</text
      ></view
    >
    <view wx:if="{{demo}}" class="atlas-demo" bindtap="clearDemo"
      >示例足迹 · 开始我的手账 ↗</view
    >
  </block>
  <block wx:elif="{{tab === 'trips'}}">
    <view class="trips-title">MY TRIPS</view>
    <scroll-view scroll-x class="trip-years"
      ><text
        wx:for="{{years}}"
        wx:key="*this"
        class="{{year === item ? 'selected-year' : ''}}"
        data-value="{{item}}"
        bindtap="year"
        >{{item === '全部' ? 'All' : item}}</text
      ></scroll-view
    >
    <view
      wx:for="{{visibleTrips}}"
      wx:key="id"
      class="reference-trip"
      data-id="{{item.id}}"
      bindtap="openItinerary"
      ><image
        wx:if="{{item.cover}}"
        src="{{item.cover}}"
        mode="aspectFill"
      /><view wx:else class="trip-placeholder">✦</view
      ><view class="reference-trip-copy"
        ><view>{{item.displayCity}} · {{item.displayCountry}}</view
        ><text>{{item.date}} - {{item.end}}</text
        ><text>{{item.days}} days · {{item.count}} photos</text></view
      ></view
    >
    <view wx:if="{{!visibleTrips.length}}" class="empty" bindtap="addTrip"
      >＋ 收藏第一段旅行</view
    >
  </block>
  <block wx:elif="{{tab === 'light'}}">
    <block wx:if="{{lightView === 'map'}}"
      ><view class="light-heading"
        >THE LIGHT I'VE CHASED<text data-value="gallery" bindtap="setLightView"
          >✣</text
        ></view
      ><view class="light-map-wrap"
        ><canvas
          type="2d"
          class="light-canvas"
          bindtap="lightMapTap"
        ></canvas></view
      ><scroll-view scroll-x class="light-strip"
        ><image
          wx:for="{{monthLightPhotos}}"
          wx:key="url"
          src="{{item.url}}"
          mode="aspectFill"
          data-url="{{item.url}}"
          bindtap="preview" /></scroll-view
      ><slider
        class="light-slider"
        min="1"
        max="12"
        value="{{lightMonth}}"
        activeColor="#ded2b5"
        backgroundColor="#686157"
        block-size="14"
        block-color="#eee7d7"
        bindchange="month"
      /><view class="month-labels"
        ><text>Jan</text><text>{{lightMonth}} 月</text><text>Dec</text></view
      ><view class="chased-counts"
        ><view><text>{{sunrises}}</text>SUNRISES</view
        ><view><text>{{sunsets}}</text>SUNSETS</view
        ><view><text>{{lightCountryCount}}</text>COUNTRIES</view></view
      ><view class="chased-quote"
        >追逐每一场日出日落，<text>也追逐更大的自己。</text></view
      ><view
        class="light-paperplane"
        data-value="gallery"
        bindtap="setLightView"
        >➤</view
      ><view
        class="light-gallery-link"
        data-value="gallery"
        bindtap="setLightView"
        >GOLDEN HOUR · 打开追光相册 ↗</view
      ></block
    >
    <block wx:else
      ><view class="golden-title"
        >GOLDEN HOUR<text data-value="map" bindtap="setLightView">☼</text></view
      ><view class="golden-subtitle"
        >日出与日落<text>收藏每一场值得的天空。</text></view
      ><view class="golden-filters"
        ><text
          wx:for="{{lightFilters}}"
          wx:key="id"
          class="{{filter === item.id ? 'is-current' : ''}}"
          data-value="{{item.id}}"
          bindtap="filter"
          >{{item.label}}</text
        ><picker range="{{lightCities}}" bindchange="setLightCity"
          ><view>{{lightCity === '全部' ? 'Cities' : lightCity}}</view></picker
        ></view
      ><view class="golden-grid"
        ><view wx:for="{{lights}}" wx:key="photoKey" class="golden-card"
          ><view class="golden-photo" data-url="{{item.url}}" bindtap="preview"
            ><image src="{{item.url}}" mode="aspectFill" /><text
              >{{item.kind === '日出' ? '☼' : '◒'}}</text
            ></view
          ><view class="golden-caption"
            ><view>{{item.displayCity}}</view
            ><text>{{item.date}} · {{item.time}}</text></view
          ></view
        ></view
      ><view wx:if="{{!lights.length}}" class="empty" bindtap="addStop"
        >＋ 收藏下一场天空</view
      ></block
    >
  </block>
  <block wx:elif="{{tab === 'souvenirs'}}"
    ><view class="souvenir-heading"
      >SOUVENIRS<text bindtap="addSouvenir">◎</text></view
    ><view class="souvenir-subtitle"
      >Things from places.<text>Memories for a lifetime.</text></view
    ><view class="souvenir-filters"
      ><text
        wx:for="{{souvenirFilters}}"
        wx:key="*this"
        class="{{souvenirFilter === item ? 'is-current' : ''}}"
        data-value="{{item}}"
        bindtap="setSouvenirFilter"
        >{{item}}</text
      ></view
    ><view class="souvenir-board"
      ><image
        class="cork-backing"
        src="/assets/cork.jpg"
        mode="aspectFill"
      /><view class="board-string"></view
      ><view
        wx:for="{{visibleSouvenirs}}"
        wx:key="id"
        class="hanging-piece piece-{{index % 6}} {{item.cutout ? 'cutout-piece' : ''}}"
        data-id="{{item.id}}"
        bindtap="viewSouvenir"
        ><view class="hanging-thread"></view><view class="piece-clip"></view
        ><image
          src="{{item.photos[0]}}"
          mode="{{item.cutout ? 'aspectFit' : 'aspectFill'}}"
        /><view class="piece-label"
          >{{item.city}}<text>{{item.name}}</text></view
        ></view
      ><view class="board-tag"><view>大理</view>DALI</view
      ><view class="board-note">风吹过的地方，<text>都成了回忆。</text></view
      ><view
        wx:if="{{!visibleSouvenirs.length}}"
        class="board-empty"
        bindtap="addSouvenir"
        >＋ 把第一件纪念品挂在这里</view
      ></view
    ><view class="small-add" bindtap="addSouvenir">＋ 添加纪念品</view></block
  >
  <block wx:else
    ><view class="headline english">MY ATLAS</view
    ><view class="subtitle">把喜欢的世界，收进自己的手账。</view
    ><view class="profile-seal">旅<text>ON THE ROAD</text></view
    ><view class="stats"
      ><view><text>{{trips.length}}</text>段旅行</view
      ><view><text>{{photoCount}}</text>张回忆</view
      ><view><text>{{souvenirs.length}}</text>件纪念品</view></view
    ><view class="menu-row" bindtap="souvenirs"
      ><view>我的收藏柜<text>Souvenirs from somewhere</text></view
      ><text>↗</text></view
    ><view class="menu-row" bindtap="exportData"
      ><view>导出记录数据<text>JSON 备份 · 不含照片文件</text></view
      ><text>↗</text></view
    ><view class="privacy"
      >这是一册保存在当前设备的私人手账。
      尚未接入账号与云同步；清理小程序数据会丢失记录和照片。请保留原相册照片，重要记录可导出。</view
    ><view class="quote serif">世界辽阔，幸好有迹可循。</view></block
  >
  <view wx:if="{{tab === 'mine' && !detail}}" class="footer-note"
    >ROAM · 留下足迹，带走故事</view
  >
</view>
<view wx:if="{{!detail}}" class="bottom-nav"
  ><view
    wx:for="{{tabs}}"
    wx:key="id"
    class="nav-item {{tab === item.id || (tab === 'souvenirs' && item.id === 'mine') ? 'current' : ''}} {{item.id === 'add' ? 'add-nav' : ''}}"
    data-id="{{item.id}}"
    bindtap="nav"
    ><view wx:if="{{item.id === 'add'}}">＋</view
    ><image wx:else class="nav-drawing" src="{{item.asset}}" /><text
      >{{item.label}}</text
    ></view
  ></view
>
<view
  wx:if="{{editor}}"
  class="overlay {{editor === 'souvenir' ? 'souvenir-editor' : ''}}"
  ><scroll-view
    scroll-y
    class="sheet {{editor === 'souvenir' ? 'souvenir-editor-sheet' : ''}}"
    ><view class="sheet-head"
      ><view
        >{{editor === 'trip' ? '收藏一段旅行' : editor === 'stop' ? '留下一个片刻' : '添加纪念品'}}</view
      ><text bindtap="closeEditor">×</text></view
    ><view wx:if="{{editor !== 'souvenir'}}" class="eyebrow"
      >A NEW PAGE IN YOUR JOURNAL</view
    >
    <view class="upload" bindtap="choosePhotos"
      ><view wx:if="{{editor === 'souvenir'}}" class="upload-camera">◎</view
      >{{editor === 'souvenir' ? '拍照上传' : '＋ 从相册选择 / 拍摄'}}<view
        >{{editor === 'souvenir' ? '可以是实物、门票、明信片、手账，或是带有当地特色的任何东西。' : '最多 9 张 · 照片将保存到小程序本地'}}</view
      ></view
    ><scroll-view scroll-x class="draft-photos"
      ><view wx:for="{{form.photos}}" wx:key="*this"
        ><image src="{{item}}" mode="aspectFill" /><text
          data-index="{{index}}"
          bindtap="removePhoto"
          >×</text
        ></view
      ></scroll-view
    >
    <block wx:if="{{editor === 'trip'}}"
      ><view class="label">旅行名称 *</view
      ><input
        placeholder="例如：风吹过的大理"
        value="{{form.title}}"
        data-field="title"
        bindinput="field"
        maxlength="60"
      /><view class="label">城市定位 *</view
      ><picker range="{{cityOptions}}" bindchange="chooseCity"
        ><view class="input">选择常用城市（或在下方手动填写） ▾</view></picker
      ><view class="location-link" bindtap="chooseLocation"
        >⌖ 在地图中选一个地点（自动填写坐标）</view
      ><input
        placeholder="城市名称"
        value="{{form.city}}"
        data-field="city"
        bindinput="field"
        maxlength="40"
      /><input
        placeholder="国家 / 地区"
        value="{{form.country}}"
        data-field="country"
        bindinput="field"
        maxlength="40"
      /><view class="coordinates"
        ><input
          placeholder="纬度 -90 至 90"
          value="{{form.latitude}}"
          data-field="latitude"
          bindinput="field" /><input
          placeholder="经度 -180 至 180"
          value="{{form.longitude}}"
          data-field="longitude"
          bindinput="field" /></view
      ><view class="helper"
        >经纬度用于点亮地图；可从地图服务查询坐标。</view
      ></block
    >
    <block wx:else
      ><view class="label"
        >{{editor === 'souvenir' ? '纪念品名称' : '去过的地点'}} *</view
      ><input
        placeholder="给这份回忆起个名字"
        value="{{form.name}}"
        data-field="name"
        bindinput="field"
        maxlength="80"
      /><view class="label">所属旅行</view
      ><picker
        range="{{tripNames}}"
        value="{{form.tripIndex}}"
        bindchange="pickTrip"
        ><view class="input">{{tripNames[form.tripIndex]}} ▾</view></picker
      ><view class="label"
        >{{editor === 'stop' ? '特别的时刻' : '纪念品类别'}}</view
      ><picker
        range="{{editor === 'stop' ? categories : kinds}}"
        bindchange="pickKind"
        ><view class="input">{{form.kind}} ▾</view></picker
      ></block
    >
    <view class="label">{{editor === 'trip' ? '开始日期' : '记录日期'}}</view
    ><picker
      mode="date"
      value="{{form.date}}"
      data-field="date"
      bindchange="field"
      ><view class="input">{{form.date}}</view></picker
    ><block wx:if="{{editor === 'trip'}}"
      ><view class="label">结束日期</view
      ><picker
        mode="date"
        value="{{form.end}}"
        data-field="end"
        bindchange="field"
        ><view class="input">{{form.end}}</view></picker
      ></block
    ><block wx:if="{{editor === 'stop'}}"
      ><view class="label">当地时间</view
      ><picker
        mode="time"
        value="{{form.time}}"
        data-field="time"
        bindchange="field"
        ><view class="input">{{form.time}}</view></picker
      ></block
    ><view class="label">留一句话</view
    ><textarea
      placeholder="当时的风、遇见的人，或买下它的理由……"
      value="{{form.note}}"
      data-field="note"
      bindinput="field"
      maxlength="1000" /><view class="error">{{error}}</view
    ><button
      class="primary"
      bindtap="save"
      loading="{{saving}}"
      disabled="{{saving}}"
    >
      {{saving ? '正在保存照片…' : '收藏这份回忆'}}</button
    ><view class="sheet-space"></view></scroll-view
></view>
<view
  wx:if="{{souvenir}}"
  class="souvenir-detail-page"
  style="padding-top:{{safeTop}}px"
  ><view class="souvenir-detail-tools"
    ><text bindtap="closeSouvenir">‹</text
    ><text bindtap="closeSouvenir">完成</text></view
  ><view class="souvenir-detail-photo"
    ><image
      src="{{souvenir.photos[0]}}"
      mode="aspectFill"
      data-url="{{souvenir.photos[0]}}"
      data-urls="{{souvenir.photos}}"
      bindtap="preview"
    /><text
      data-url="{{souvenir.photos[0]}}"
      data-urls="{{souvenir.photos}}"
      bindtap="preview"
      >原图</text
    ></view
  ><view class="souvenir-thumbnails"
    ><image
      wx:for="{{souvenir.photos}}"
      wx:key="*this"
      src="{{item}}"
      mode="aspectFill"
      data-url="{{item}}"
      data-urls="{{souvenir.photos}}"
      bindtap="preview" /></view
  ><view class="souvenir-data-row"
    ><text>名称</text><view>{{souvenir.name}}</view></view
  ><view class="souvenir-data-row"
    ><text>类别</text><view>{{souvenir.kind}}</view></view
  ><view class="souvenir-data-row"
    ><text>所属城市</text><view>{{souvenir.city}}</view></view
  ><view class="souvenir-data-row"
    ><text>日期</text><view>{{souvenir.date}}</view></view
  ><view class="souvenir-data-row"
    ><text>备注</text><view>{{souvenir.note}}</view></view
  ><view class="small-add" bindtap="deleteSouvenir">删除这件纪念品</view></view
>
<view wx:if="{{citySheet}}" class="overlay"
  ><scroll-view scroll-y class="sheet"
    ><view class="sheet-head"
      ><text>{{citySheet.name}} · 历次旅行</text
      ><text bindtap="closeCity">×</text></view
    ><view
      wx:for="{{citySheet.trips}}"
      wx:key="id"
      class="trip-row"
      data-id="{{item.id}}"
      bindtap="openTrip"
      ><image
        wx:if="{{item.cover}}"
        src="{{item.cover}}"
        mode="aspectFill"
      /><view class="trip-copy"
        ><view class="serif">{{item.title}}</view
        ><view>{{item.date}} — {{item.end}}</view></view
      ><text>↗</text></view
    ><view class="sheet-space"></view></scroll-view
></view>

<view wx:if="{{viewer}}" class="photo-viewer {{fullPhoto ? 'immersive' : ''}}">
  <view class="viewer-toolbar" style="padding-top:{{safeTop}}px"
    ><text bindtap="closeViewer">‹</text
    ><view>{{viewerIndex + 1}} / {{photos.length}}</view
    ><text bindtap="shareMemory">···</text></view
  >
  <swiper
    class="viewer-stage"
    current="{{viewerIndex}}"
    bindchange="viewerChange"
    duration="380"
    ><swiper-item wx:for="{{photos}}" wx:key="photoKey"
      ><view
        class="viewer-frame"
        style="transform:rotate({{fullPhoto ? 0 : 3 + tilt}}deg)"
        bindtouchstart="touchStart"
        bindtouchmove="touchMove"
        bindtouchend="touchEnd"
        bindtouchcancel="touchEnd"
        ><view wx:if="{{!fullPhoto}}" class="viewer-film-label"
          >ROAM PORTRA 400 <text>{{index + 1}} ▷</text></view
        ><image
          class="viewer-photo"
          src="{{item.url}}"
          mode="{{fullPhoto ? 'aspectFit' : 'aspectFill'}}"
          bindtap="fullPhoto"
          data-url="{{item.url}}"
          data-urls="{{photoUrls}}"
          bindlongpress="preview"
        /><view wx:if="{{!fullPhoto}}" class="viewer-film-label"
          >▷ {{item.date}} <text>{{index + 1}}</text></view
        ></view
      ></swiper-item
    ></swiper
  >
  <scroll-view
    wx:if="{{!fullPhoto}}"
    scroll-x
    class="viewer-thumbs"
    scroll-into-view="thumb-{{viewerIndex}}"
    scroll-with-animation
    ><image
      wx:for="{{photos}}"
      wx:key="photoKey"
      id="thumb-{{index}}"
      class="{{viewerIndex === index ? 'thumb-active' : ''}}"
      src="{{item.url}}"
      mode="aspectFill"
      data-index="{{index}}"
      bindtap="viewerThumb"
  /></scroll-view>
  <view class="viewer-info"
    ><view class="viewer-location"
      ><view>{{active.city}} · {{active.country}}</view
      ><view
        ><text bindtap="toggleFavorite">{{active.favorite ? '♥' : '♡'}}</text
        ><text bindtap="shareMemory">↥</text></view
      ></view
    ><view class="viewer-date"
      >{{photos[viewerIndex].date}} {{photos[viewerIndex].time}}</view
    ><view class="viewer-note">{{photos[viewerIndex].note || active.note}}</view
    ><view wx:if="{{fullPhoto}}" class="viewer-help" bindtap="fullPhoto"
      >轻触照片返回胶卷 · 长按查看原图</view
    ></view
  >
</view>
