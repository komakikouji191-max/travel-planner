.app {
  padding: 36rpx 36rpx 180rpx;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 10% 0, #fffaf077, transparent 70%), #f3eddf;
}
.masthead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #c9c0af;
  padding-bottom: 22rpx;
}
.wordmark {
  letter-spacing: 4rpx;
  font-size: 25rpx;
  font-weight: bold;
}
.edition {
  font-size: 15rpx;
  letter-spacing: 1rpx;
  color: #827c70;
}
.demo {
  font-size: 20rpx;
  background: #e6dcc7;
  padding: 15rpx;
  margin-top: 22rpx;
  color: #71614c;
}
.heading-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.headline {
  font-family: Georgia, "Songti SC", serif;
  font-size: 61rpx;
  letter-spacing: -2rpx;
  margin-top: 45rpx;
  line-height: 1.12;
}
.english {
  font-size: 76rpx;
  letter-spacing: -3rpx;
}
.subtitle {
  font-size: 23rpx;
  line-height: 1.8;
  color: #89806f;
  margin: 18rpx 0 32rpx;
}
.sun-seal {
  font-size: 70rpx;
  color: #aa7845;
}
.map-shell {
  position: relative;
  margin: 0 -36rpx;
  height: 650rpx;
  background: #e7e1d3;
}
.atlas {
  width: 100%;
  height: 100%;
}
.map-badge {
  position: absolute;
  top: 22rpx;
  left: 32rpx;
  pointer-events: none;
  background: #f7f0dfdf;
  padding: 14rpx 20rpx;
  font:
    24rpx Georgia,
    serif;
  letter-spacing: 3rpx;
}
.map-badge text {
  display: block;
  font: 17rpx sans-serif;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
  color: #7f7159;
}
.map-note {
  text-align: center;
  font-size: 19rpx;
  color: #8e8270;
  margin: 18rpx 0;
}
.stats {
  display: flex;
  text-align: center;
  padding: 26rpx 0 34rpx;
  border-bottom: 1rpx solid #cfc5b3;
}
.stats > view {
  flex: 1;
  font-size: 20rpx;
  color: #766f62;
}
.stats text {
  display: block;
  font:
    57rpx Georgia,
    serif;
  color: #30342f;
  margin-bottom: 10rpx;
}
.segmented {
  display: flex;
  margin: 28rpx auto 40rpx;
  background: #e5ddce;
  padding: 7rpx;
  border-radius: 50rpx;
  width: 450rpx;
}
.segmented text {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 22rpx;
  border-radius: 40rpx;
}
.segmented .selected {
  background: #293c45;
  color: #faf4e6;
}
.section-label {
  letter-spacing: 2rpx;
  font-size: 21rpx;
  padding: 20rpx 0;
}
.section-label text {
  float: right;
  font-size: 20rpx;
  letter-spacing: 0;
  color: #8e8270;
}
.trip-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d8cebb;
}
.trip-row image,
.cover-blank {
  width: 160rpx;
  height: 145rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.cover-blank {
  background: #d9d1bd;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b7652;
  font-size: 45rpx;
}
.trip-copy {
  flex: 1;
}
.trip-copy .serif {
  font-size: 33rpx;
  margin-bottom: 15rpx;
  font-weight: bold;
}
.trip-copy > view:not(.serif) {
  font-size: 20rpx;
  color: #807565;
}
.trip-copy > text {
  display: block;
  font-size: 22rpx;
  color: #8b806c;
  margin-top: 12rpx;
}
.large image,
.large .cover-blank {
  width: 205rpx;
  height: 200rpx;
}
.horizontal {
  white-space: nowrap;
  margin: 30rpx 0;
}
.date-chip {
  display: inline-block;
  padding: 15rpx 12rpx;
  margin-right: 25rpx;
  font-family: Georgia, serif;
  font-size: 27rpx;
  color: #8d8373;
}
.chosen {
  color: #2c393d !important;
  border-bottom: 4rpx solid #2c393d;
  font-weight: bold;
}
.footer-note {
  text-align: center;
  color: #a59880;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  margin-top: 65rpx;
}
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 18rpx 12rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #f6f0e4f5;
  border-top: 1rpx solid #d5cbb7;
  z-index: 5;
}
.nav-item {
  text-align: center;
  color: #9a907f;
  width: 110rpx;
}
.nav-item > view {
  font-size: 44rpx;
  height: 54rpx;
  line-height: 54rpx;
}
.nav-item > text {
  font-size: 19rpx;
}
.nav-item.current {
  color: #273d49;
  font-weight: bold;
}
.add-nav > view {
  border-radius: 50%;
  background: #293c45;
  color: #fff;
  width: 82rpx;
  height: 82rpx;
  line-height: 76rpx;
  margin: -38rpx auto 5rpx;
  font-size: 55rpx;
  box-shadow: 0 6rpx 12rpx #273d4933;
}
.backline {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  color: #89775c;
  font-size: 23rpx;
}
.city-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 68rpx;
  margin: 35rpx 0 16rpx;
}
.city-title text {
  font-size: 24rpx;
  color: #97856b;
  margin-left: 22rpx;
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #97856b;
}
.poem {
  font-family: Georgia, "Songti SC", serif;
  font-size: 27rpx;
  color: #80735d;
  line-height: 1.9;
  margin: 28rpx 0;
  white-space: pre-wrap;
}
.section-tabs {
  display: flex;
  gap: 38rpx;
  border-bottom: 1rpx solid #cec3ae;
  margin: 30rpx 0;
}
.section-tabs text {
  font-size: 25rpx;
  padding: 22rpx 0;
  color: #8f8069;
}
.film-hint {
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #9e8969;
  margin: 45rpx 0 25rpx;
}
.film-scroll {
  width: calc(100% + 72rpx);
  margin-left: -36rpx;
  white-space: nowrap;
  padding: 30rpx 0 60rpx;
  overflow: hidden;
}
.film {
  display: inline-flex;
  min-width: 100%;
  padding: 0 45rpx;
  transform-origin: center;
  transition: transform 0.22s ease-out;
}
.frame {
  display: inline-block;
  width: 540rpx;
  padding: 32rpx 22rpx;
  background: #242827;
  border-top: 17rpx dashed #b9ac8c;
  border-bottom: 17rpx dashed #b9ac8c;
  box-shadow: 0 20rpx 25rpx #33281930;
}
.frame image {
  width: 496rpx;
  height: 530rpx;
  display: block;
}
.film-code {
  color: #bd9d6d;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  padding: 9rpx 0;
}
.film-code text {
  float: right;
}
.quote {
  font-size: 29rpx;
  line-height: 1.9;
  text-align: center;
  margin: 35rpx 0 55rpx;
  color: #897859;
}
.photo-caption {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  border-bottom: 1rpx solid #d4c8b0;
  padding: 20rpx 0;
}
.photo-caption text:last-child {
  color: #ad9060;
  font-size: 18rpx;
}
.empty {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #93846a;
  font-size: 25rpx;
  line-height: 2;
}
.empty > view {
  margin-top: 20rpx;
}
.film-empty {
  height: 400rpx;
  width: 670rpx;
  background: #292c2a;
  padding-top: 120rpx;
}
.timeline {
  margin: 35rpx 0 0 15rpx;
  padding-left: 35rpx;
  border-left: 2rpx solid #8c826c;
}
.stop {
  position: relative;
  padding: 0 0 48rpx;
}
.dot {
  position: absolute;
  left: -45rpx;
  top: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 4rpx solid #41473f;
  background: #f3eddf;
}
.stop-title {
  font-size: 33rpx;
  font-weight: bold;
  margin: 16rpx 0;
}
.note {
  font-size: 25rpx;
  color: #85785f;
  line-height: 1.8;
  white-space: pre-wrap;
}
.stop-photos {
  white-space: nowrap;
  margin-top: 20rpx;
}
.stop-photos image {
  display: inline-block;
  width: 160rpx;
  height: 175rpx;
  margin-right: 12rpx;
  border-radius: 5rpx;
}
.night {
  background:
    radial-gradient(ellipse at 80% 10%, #5d45362f, transparent 60%), #24282a;
  color: #efe7d7;
}
.night .masthead {
  border-color: #514d43;
}
.night .subtitle {
  color: #b0a38e;
}
.gold {
  color: #d8ad70;
  margin-top: 40rpx;
}
.night .chosen {
  color: #e3bb82 !important;
  border-color: #e3bb82;
}
.night .section-tabs {
  border-color: #514a3e;
}
.night .section-tabs text {
  color: #a59b89;
}
.night .outline {
  color: #dabb91;
  border-color: #6b5e4a;
}
.light-summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  text-align: center;
  margin: 40rpx 0;
}
.light-summary > view {
  font-size: 21rpx;
  color: #b7a58c;
}
.light-summary text {
  display: block;
  font:
    65rpx Georgia,
    serif;
  color: #f2dfbc;
  margin-bottom: 10rpx;
}
.light-summary .sun-orbit {
  font-size: 100rpx;
  color: #d5a86d;
  text-shadow: 0 0 35rpx #d5a86d66;
  animation: breathe 4s infinite;
}
.polaroid-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}
.polaroid {
  width: calc(50% - 11rpx);
  background: #eee5d3;
  color: #343733;
  padding: 12rpx 12rpx 22rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 8rpx 20rpx #0002;
}
.polaroid:nth-child(even) {
  transform: rotate(1deg);
}
.photo-wrap {
  position: relative;
}
.photo-wrap image {
  width: 100%;
  height: 295rpx;
  display: block;
}
.type-badge {
  position: absolute;
  top: 12rpx;
  left: 10rpx;
  background: #fbefdbdf;
  color: #695637;
  font-size: 18rpx;
  padding: 7rpx 10rpx;
  border-radius: 20rpx;
}
.polaroid > .serif {
  font-size: 31rpx;
  margin: 17rpx 4rpx 10rpx;
}
.small {
  font-size: 19rpx;
  color: #8c7a5e;
}
.profile-seal {
  width: 220rpx;
  height: 220rpx;
  border: 1rpx solid #bdb097;
  border-radius: 50%;
  text-align: center;
  padding-top: 35rpx;
  margin: 50rpx auto;
  font:
    90rpx Georgia,
    "Songti SC",
    serif;
  color: #7d674c;
}
.profile-seal text {
  display: block;
  font:
    17rpx Georgia,
    serif;
  letter-spacing: 2rpx;
  margin-top: 18rpx;
}
.menu-row {
  padding: 36rpx 0;
  border-bottom: 1rpx solid #cfc5b3;
  display: flex;
  justify-content: space-between;
  font-size: 31rpx;
}
.menu-row view text {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #9c8c72;
}
.privacy {
  font-size: 23rpx;
  line-height: 1.9;
  color: #9b896c;
  margin-top: 36rpx;
}
.cork {
  background: #b49b72;
  background-image: radial-gradient(#79634555 0.8px, transparent 1px);
  background-size: 5px 5px;
  margin-top: 40rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  min-height: 450rpx;
  box-shadow: inset 0 0 25rpx #67503155;
}
.cork .empty {
  color: #fff5df;
  width: 100%;
  padding-top: 100rpx;
}
.souvenir-card {
  position: relative;
  width: calc(50% - 12rpx);
  background: #f4e9d5;
  padding: 15rpx 15rpx 23rpx;
  transform: rotate(-2deg);
  box-shadow: 0 8rpx 15rpx #3d2f2455;
  margin-top: 20rpx;
}
.souvenir-card:nth-child(even) {
  transform: rotate(3deg);
}
.souvenir-card image {
  width: 100%;
  height: 240rpx;
}
.souvenir-card .serif {
  font-size: 26rpx;
  margin: 15rpx 0;
}
.pin {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: #8b533c;
  border-radius: 50%;
  top: -7rpx;
  left: 48%;
  z-index: 1;
  box-shadow: 2rpx 3rpx 4rpx #0005;
}
.overlay {
  position: fixed;
  inset: 0;
  background: #171e26aa;
  z-index: 20;
  display: flex;
  align-items: flex-end;
}
.sheet {
  max-height: 89vh;
  width: 100%;
  background: #f3eddf;
  padding: 35rpx 32rpx 0;
  border-radius: 20rpx 20rpx 0 0;
}
.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: Georgia, "Songti SC", serif;
  font-size: 36rpx;
  margin-bottom: 18rpx;
}
.sheet-head > text:last-child {
  font-size: 46rpx;
  padding: 0 14rpx;
  color: #9a8665;
}
.upload {
  padding: 40rpx 20rpx;
  text-align: center;
  border: 2rpx dashed #bcac8d;
  margin-top: 30rpx;
  color: #6d745e;
  font-size: 29rpx;
}
.upload view {
  font-size: 20rpx;
  color: #a08d6e;
  margin-top: 15rpx;
}
.draft-photos {
  white-space: nowrap;
  margin-top: 20rpx;
}
.draft-photos > view {
  position: relative;
  display: inline-block;
  margin-right: 16rpx;
}
.draft-photos image {
  width: 140rpx;
  height: 140rpx;
}
.draft-photos text {
  position: absolute;
  right: 0;
  top: 0;
  background: #252c2bbb;
  color: #fff;
  padding: 0 10rpx;
  font-size: 30rpx;
}
.label {
  font-size: 23rpx;
  color: #86765c;
  margin: 26rpx 0 12rpx;
}
input,
.input,
textarea {
  width: 100%;
  background: #fff9ee;
  border: 1rpx solid #d6c9b1;
  border-radius: 4rpx;
  padding: 20rpx;
  font-size: 27rpx;
  min-height: 85rpx;
  margin-top: 10rpx;
}
.coordinates {
  display: flex;
  gap: 15rpx;
}
.coordinates input {
  width: 50%;
}
.helper {
  font-size: 20rpx;
  color: #9b8869;
  margin-top: 12rpx;
}
textarea {
  height: 180rpx;
}
.error {
  font-size: 23rpx;
  color: #a14e3e;
  margin: 20rpx 0;
}
.sheet-space {
  height: calc(60rpx + env(safe-area-inset-bottom));
}
.souvenir-hero {
  width: 100%;
  margin-top: 20rpx;
}
.souvenir-detail .city-title {
  font-size: 44rpx;
}
.souvenir-detail {
  padding-bottom: 70rpx;
}
@keyframes breathe {
  50% {
    text-shadow: 0 0 65rpx #d5a86daa;
    opacity: 0.65;
  }
}
.record-actions {
  display: flex;
  gap: 25rpx;
  justify-content: flex-end;
  font-size: 21rpx;
  color: #9d8966;
  margin-top: 10rpx;
}
.record-actions text {
  padding: 8rpx;
}
.location-link {
  font-size: 23rpx;
  color: #5d786e;
  padding: 25rpx 0 10rpx;
}
.design-entry{display:flex;justify-content:space-between;font-size:21rpx;color:#6f745e;background:#e8e2d3;padding:20rpx 16rpx;margin-top:18rpx;border:1rpx solid #d9cfba}
